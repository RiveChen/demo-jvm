{
  "version": 8,
  "configurePresets": [
    {
      "name": "base-common",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "base-debug",
      "hidden": true,
      "inherits": "base-common",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "base-release",
      "hidden": true,
      "inherits": "base-common",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "san-none",
      "hidden": true,
      "cacheVariables": {
        "ENABLE_ASAN": "OFF",
        "ENABLE_UBSAN": "OFF"
      }
    },
    {
      "name": "san-asan",
      "hidden": true,
      "cacheVariables": {
        "ENABLE_ASAN": "ON",
        "ENABLE_UBSAN": "OFF"
      }
    },
    {
      "name": "san-ubsan",
      "hidden": true,
      "cacheVariables": {
        "ENABLE_ASAN": "OFF",
        "ENABLE_UBSAN": "ON"
      }
    },
    {
      "name": "san-asan-ubsan",
      "hidden": true,
      "cacheVariables": {
        "ENABLE_ASAN": "ON",
        "ENABLE_UBSAN": "ON"
      }
    },
    {
      "name": "dev",
      "displayName": "Development",
      "description": "Debug build with tests and no sanitizers.",
      "inherits": ["base-debug", "san-none"]
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Optimized release build with tests.",
      "inherits": ["base-release", "san-none"]
    },
    {
      "name": "asan",
      "displayName": "AddressSanitizer",
      "description": "Debug build instrumented with AddressSanitizer.",
      "inherits": ["base-debug", "san-asan"]
    },
    {
      "name": "ubsan",
      "displayName": "UndefinedBehaviorSanitizer",
      "description": "Debug build instrumented with UndefinedBehaviorSanitizer.",
      "inherits": ["base-debug", "san-ubsan"]
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "ubsan",
      "configurePreset": "ubsan"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ubsan",
      "configurePreset": "ubsan",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
